@using Fdm.Ams.ViewModels
@model TrainerViewModel


<div class="modal-content">
    <div class="modal-header">
        <h5 class="modal-title">Create Trainer</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>

    <form method="post" asp-action="Post"
          id="partial-form" data-ajax="true" data-ajax-update="#partial-form" data-ajax-mode="replace">
        <div class="modal-body show success-message-slider">
            <h1 class="h3">Details</h1>
            <div class="row pl-0">
                <div class="col-sm-6 form-group">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" onblur="this.value = this.value.trimEnd()"/>
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="col-sm-6 form-group">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" onblur="this.value = this.value.trimEnd()"/>
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="col-sm-6 form-group">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-sm-6 form-group">
                    <label asp-for="Username" class="form-label"></label>
                    <input asp-for="Username" class="form-control" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="col-sm-6 form-group">
                    <label asp-for="OfficeId" class="form-label"></label>
                    <select class="form-control" asp-for="OfficeId"
                            asp-items="@(new SelectList(Model.OfficeDictionaries, "Key", "Value"))">
                        <option value="">Please select Office</option>
                    </select>
                    <span asp-validation-for="OfficeId" class="text-danger"></span>
                </div>

                <div class="col-sm-6 form-group">
                    <label asp-for="TeamName" class="form-label"></label>
                    <input asp-for="TeamName" class="form-control" />
                    <span asp-validation-for="TeamName" class="text-danger"></span>
                </div>
                <div class="col-sm-6 form-group">
                    <label asp-for="Active" class="form-label"></label>
                    <select asp-for="Active" class="form-control">
                        <option value="false">Inactive</option>
                        <option selected="selected" value="true">Active</option>

                    </select>
                </div>
            </div>

            <div class="modal-footer show create-button-slider">
                <div class="mr-lg-n3">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>

                    <button type="button" class="btn btn-primary"
                            data-toggle="collapse" data-target=".create-button-slider" aria-expanded="false"
                            aria-controls="create-button-slider">
                        Create
                    </button>
                </div>

            </div>

            <div class="create-button-slider collapse">
                <div class="alert alert-warning text-center">Are you sure you want to add this Trainer?</div>
                <div class="text-right">
                    <button class="btn btn-secondary" type="button"
                            data-toggle="collapse" data-target=".create-button-slider" aria-expanded="false"
                            aria-controls="create-button-slider">
                        Cancel
                    </button>
                    <button id="confirm-create-new-trainer" type="submit"
                            class="btn btn-primary">
                        Confirm
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>
