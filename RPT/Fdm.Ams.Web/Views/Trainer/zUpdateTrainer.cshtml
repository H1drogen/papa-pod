@using Fdm.Ams.ViewModels
@model TrainerViewModel

<div class="modal-content">
    <div class="modal-header">
        <h5 class="modal-title">Trainer Profile @Model.FirstName</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
    <form method="post" asp-action="Edit"
          id="partial-form" data-ajax="true" data-ajax-update="#partial-form" data-ajax-mode="replace">
        <div class="modal-body">
            <h1 class="h3">Details</h1>
            <div class="row pl-0">
                <input type="hidden" asp-for="Id" class="form-control">
                <div class="col-sm-6 form-group">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="col-sm-6 form-group">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control">
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="col-sm-6 form-group">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-sm-6 form-group">
                    <label asp-for="Username" class="form-label"></label>
                    <input asp-for="Username" class="form-control" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="col-sm-6 form-group">
                    <label asp-for="OfficeId" class="form-label"></label>
                    <select class="form-control" asp-for="OfficeId"
                            asp-items="@(new SelectList(Model.OfficeDictionaries, "Key", "Value"))">
                        <option value="">Please select Office</option>
                    </select>
                    <span asp-validation-for="OfficeId" class="text-danger"></span>
                </div>

                <div class="col-sm-6 form-group">
                    <label asp-for="TeamName" class="form-label"></label>
                    <input asp-for="TeamName" class="form-control" />
                    <span asp-validation-for="TeamName" class="text-danger"></span>
                </div>
                <div class="col-sm-6 form-group">
                    <label asp-for="Active" class="form-label"></label>
                    <select asp-for="Active" class="form-control">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                </div>
            </div>

            <div class="modal-footer show update-button-slider delete-button-slider">
                <div class="mr-auto m-n3">
                    <button type="button" class="btn btn-danger" data-toggle="collapse" data-target=".delete-button-slider" aria-expanded="false"
                            aria-controls="delete-button-slider">
                        Archive
                    </button>
                </div>
                <div class="mr-lg-n3">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>

                    <button type="button" class="btn btn-primary"
                            data-toggle="collapse" data-target=".update-button-slider" aria-expanded="false"
                            aria-controls="update-button-slider">
                        Update
                    </button>
                </div>
            </div>

            <div class="update-button-slider collapse">
                <div class="alert alert-warning text-center">Are you sure you want to update this Trainer?</div>
                <div class="text-right">
                    <button class="btn btn-secondary" type="button"
                            data-toggle="collapse" data-target=".update-button-slider" aria-expanded="false"
                            aria-controls="update-button-slider">
                        Cancel
                    </button>
                    <button asp-action="Edit" type="submit"
                            class="btn btn-primary">
                        Confirm
                    </button>
                </div>
            </div>

            <div class="delete-button-slider collapse">
                <div class="alert alert-warning text-center">
                    Are you sure you want to archive this Trainer?
                </div>
                <div class="text-right">
                    <button class="btn btn-secondary" type="button" id="cancel-delete-trainer" data-toggle="collapse" data-target=".delete-button-slider" aria-expanded="false"
                            aria-controls="delete-button-slider">
                        Cancel
                    </button>
                    <button type="submit" asp-action="Delete" class="btn btn-danger">Confirm</button>
                </div>
            </div>

        </div>
    </form>
</div>

