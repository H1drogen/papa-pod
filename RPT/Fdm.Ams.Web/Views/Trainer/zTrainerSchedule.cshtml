@{
    ViewBag.Title = "Trainer Schedule";
}

<div class="main-content--light pt-2">
    <div class="is-flex">
        <partial name="_AcademyAdminAside" />

        <section id="main-content" class="container-fluid [ min-height--full ] content__container">
            <div class="row">
                <div id="extra-modules-sidebar">
                    <h3>Activities</h3>
                    <div class="card bg-dark mt-3 text-white p-1 d-none module" id="extra-module-template"></div>
                </div>
                <div class="col">
                    <h2 class="text-center col-sm">Trainer Schedule</h2>
                    @if (ViewBag.SuccessMessageTrainerSchedule != null)
                    {

                        <div class="alert alert-success text-center alert-dismissible fade show alert-success" role="alert">
                            @ViewBag.SuccessMessageTrainerSchedule
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    }

                    <div  id="trainerCalendar"></div>
                </div>
            </div>

            <partial name="_TrainerScheduleUpdateActivity" />


            <div id="trainer-schedule-update" class="modal" tabindex="-1" role="dialog">
                <div class="modal-dialog trainer-schedule-update-modal " role="document">
                </div>
            </div>



        </section>
    </div>
</div>

<script src="~/js/AcademyAdmin/TrainerSchedule.js" type="module"></script>