@model Fdm.Ams.ViewModels.TrainerRoleViewModel


        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Update Trainer Role @Model.Name</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>


    <form method="post" asp-action="Edit"
          id="partial-form" data-ajax="true" data-ajax-update="#partial-form" data-ajax-mode="replace">
                <div class="modal-body modal-lg">
                    <fieldset>
                        <input type="hidden" asp-for="Id" class="form-control" />
                        <div class="row row--spacing">
                            <span class="col-5"><label asp-for="Name" class="form-label"></label></span>
                            <input  asp-for="Name" class="col-6 text--smaller form-control">
                            <span class="col-5 text-danger"></span>
                            <span asp-validation-for="Name" class="col-6 text-danger"></span>
                        </div>
                        <div class="row row--spacing">
                            <span class="col-5 text-left"><label asp-for="Description" class="form-label"></label></span>
                            <input asp-for="Description" class="col-6 text--smaller form-control">
                            <span class="col-5 text-danger"></span>
                            <span asp-validation-for="Description" class="col-6 text-danger"></span>
                        </div>
                    </fieldset>

            <div class="modal-footer show update-button-slider delete-button-slider">
                <div class="mr-auto m-n3">
                    <button type="button" class="btn btn-danger" data-toggle="collapse" data-target=".delete-button-slider" aria-expanded="false"
                            aria-controls="delete-button-slider">
                        Delete
                    </button>
                </div>
                <div class="mr-lg-n3">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>

                    <button type="button" class="btn btn-primary"
                            data-toggle="collapse" data-target=".update-button-slider" aria-expanded="false"
                            aria-controls="update-button-slider">
                        Update
                    </button>
                </div>
            </div>

            <div class="update-button-slider collapse">
                <div class="alert alert-warning text-center">Are you sure you want to update this Trainer Role?</div>
                <div class="text-right">
                    <button class="btn btn-secondary" type="button"
                            data-toggle="collapse" data-target=".update-button-slider" aria-expanded="false"
                            aria-controls="update-button-slider">
                        Cancel
                    </button>
                    <button asp-action="Edit" type="submit"
                            class="btn btn-primary">
                        Confirm
                    </button>
                </div>
            </div>
            <div class="delete-button-slider collapse">
                <div class="alert alert-warning text-center">
                    Are you sure you want to delete this Trainer Role?
                </div>
                <div class="text-right">
                    <button class="btn btn-secondary" type="button" id="cancel-delete-trainer" data-toggle="collapse" data-target=".delete-button-slider" aria-expanded="false"
                            aria-controls="delete-button-slider">
                        Cancel
                    </button>
                    <button type="submit" asp-action="Delete" class="btn btn-danger">Confirm</button>
                </div>
            </div>
        </div>
    </form>
</div>

