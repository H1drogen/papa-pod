@model Fdm.Ams.ViewModels.CourseModuleViewModel

<form id="update-course-module-form" class="modal-content">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Edit Course</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body modal-lg">
            <div class="row row--spacing">
                <label asp-for="Id" class="col-5"></label>
                <input asp-for="Id" id="inputId" class="col-6 text--smaller form-control" readonly />
                <span asp-validation-for="Id" class="text-danger"></span>
            </div>
            <div class="row row--spacing">
                <label asp-for="Name" class="col-5"></label>
                <input asp-for="Name" id="inputName" class="col-6 text--smaller form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="row row--spacing">
                <label asp-for="Description" class="col-5"></label>
                <input asp-for="Description" id="inputDescription" class="col-6 text--smaller form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="row row--spacing">
                <label asp-for="PreparationNotes" class="col-5"></label>
                <input asp-for="PreparationNotes" id="inputPreparationNotes" class="col-6 text--smaller form-control" />
                <span asp-validation-for="PreparationNotes" class="text-danger"></span>
            </div>
            <div class="row row--spacing">
                <label asp-for="StartDate" class="col-5"></label>
                <input asp-for="StartDate" id="inputStartDate" class="col-6 text--smaller form-control" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>
            <div class="row row--spacing">
                <label asp-for="EndDate" class="col-5"></label>
                <input asp-for="EndDate" id="inputEndDate" class="col-6 text--smaller form-control" />
                <span id="endDateError" asp-validation-for="EndDate" class="text-danger"></span>
            </div>
            <div class="col-5">
                <label class="form-check-label">
                    <input class="form-check-input" id="inputProvisional" asp-for="Provisional" /> @Html.DisplayNameFor(model => model.Provisional)
                </label>
            </div>
            <div class="row row--spacing">
                <label asp-for="TrainerId" class="col-5"></label>
                <select id="inputTrainerId" class="col-6 form-control" asp-for="TrainerId"
                        asp-items="@(new SelectList(Model.TrainerDictionary, "Key", "Value"))">
                    <option value="">UNASSIGNED</option>
                </select>
                <span asp-validation-for="TrainerId" class="text-danger"></span>
            </div>
            <div class="row row--spacing">
                <label asp-for="PathwayId" class="col-5"></label>
                <select id="inputPathwayId" class="col-6 form-control" asp-for="PathwayId"
                        asp-items="@(new SelectList(Model.PathwayDictionary, "Key", "Value"))">
                    <option value="">UNASSIGNED</option>
                </select>
                <span asp-validation-for="PathwayId" class="text-danger"></span>
            </div>
            <div class="row row--spacing">
                <label asp-for="VenueId" class="col-5"></label>
                <select id="inputVenueId" class="col-6 form-control" asp-for="VenueId"
                        asp-items="@(new SelectList(Model.VenueDictionary, "Key", "Value"))">
                    <option value="">UNASSIGNED</option>
                </select>
                <span asp-validation-for="VenueId" class="text-danger"></span>
            </div>

        </div>
        <span id="invalid-input-message" class="text-danger"></span>

        <div class="modal-footer row show create-button-slider m-0 delete-button-slider">
            <div class="mr-auto">
                <button type="button" class="btn btn-danger" data-toggle="collapse" data-target=".delete-button-slider" aria-expanded="false">Delete</button>
            </div>
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-primary" data-toggle="collapse" data-target=".create-button-slider" aria-expanded="false">Update</button>
        </div>

        <div class="create-button-slider collapse">
            <div class="alert alert-warning text-center m-4">Are you sure you want to update this Course?</div>
            <div class="text-right">
                <button class="btn btn-secondary mb-20 mr-2" type="button" data-toggle="collapse" data-target=".create-button-slider" aria-expanded="false" id="cancel-create-course">Cancel</button>
                <button id="edit-form-submit" onclick="editFormSubmit(event)" class="btn btn-primary mb-20 mr-4">Confirm</button>
                
            </div>
        </div>

        <div class="delete-button-slider collapse p-3" id="delete-button-slider">
            <div class="alert alert-warning text-center">Are you sure you wish to delete this course? Once deleted, it can't be recovered</div>
            <div class="text-right">
                <button class="btn btn-secondary  mb-4 ml-2" type="button" data-toggle="collapse" data-target=".delete-button-slider" aria-expanded="false" id="cancel-delete-course">Cancel</button>
                <button onclick="deleteFormSubmit(event)" type="submit" class="btn btn-danger  mb-4 ml-2" data-dismiss="modal">Confirm </button>
            </div>
        </div>
    </div>
    <script src="~/js/dragAndDrop.js"></script>
</form>

