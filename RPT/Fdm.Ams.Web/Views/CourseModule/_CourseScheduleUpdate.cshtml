@model Fdm.Ams.ViewModels.CourseModuleViewModel

<form id="course-schedule-form" asp-controller="CourseModule"  data-ajax="true" data-ajax-update="#course-schedule-form" data-ajax-mode="replace">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Edit Course</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body modal-lg">

            <div class="row row--spacing">
                <label asp-for="Name" class="col-5"></label>
                <input type="hidden" id="hdnId" asp-for="Id" />
                <input asp-for="Name" type="text" class="col-6 text--smaller form-control" placeholder="Enter name" />
                <span asp-validation-for="Name" class="text-danger ml-200"></span>
            </div>
            <div class="row row--spacing">
                <label asp-for="Description" class="col-5"></label>
                <input asp-for="Description" type="text" class="col-6 text--smaller form-control" placeholder="Enter Description" />
                <span asp-validation-for="Description" class="text-danger ml-200"></span>
            </div>
            <div class="row row--spacing">
                <label asp-for="PreparationNotes" class="col-5"></label>
                <input asp-for="PreparationNotes" type="text" class="col-6 text--smaller form-control" placeholder="Enter PrepNotes" />
                <span asp-validation-for="PreparationNotes" class="text-danger ml-200"></span>
            </div>
            <div class="row mb-0 mt-4">
                <div class="col-6">
                    <div class="border rounded px-2 py-1">
                        <p class="mb-0">Course</p>
                        <div class="row">
                            <div class="col-6 small">
                                Start: <label>@Model.StartDate.Value.ToShortDateString()</label>
                            </div>
                            <div class="col-6 small">
                                End: <label>@Model.EndDate.Value.ToShortDateString()</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="border rounded px-2 py-1">
                        <p class="mb-0">Pathway</p>
                        <div class="row">
                            <div class="col-6 small">
                                Start:<label>@Model.CourseStartDate.Value.ToShortDateString()</label>
                            </div>
                            <div class="col-6 small">
                                End: <label>@Model.CourseEndDate.Value.ToShortDateString()</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-footer row show create-button-slider m-0 delete-button-slider">
            <div class="mr-auto">
                <button type="button" class="btn btn-danger" data-toggle="collapse" data-target=".delete-button-slider" aria-expanded="false">Delete</button>
            </div>
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-primary" data-toggle="collapse" data-target=".create-button-slider" aria-expanded="false">Update</button>
        </div>
        <div class="create-button-slider collapse">
            <div class="alert alert-warning text-center m-4">Are you sure you want to update this Course?</div>
            <div class="text-right">
                <button class="btn btn-secondary mb-20 mr-2" data-dismiss="modal" type="submit" id="cancel-delete-course">Cancel</button>
                <button asp-action="EditAsyncForCourseSchedule" class="btn btn-primary mb-20 mr-4">Confirm</button>
            </div>
        </div>
        <div class="delete-button-slider collapse p-3" id="delete-button-slider">
            <div class="alert alert-warning text-center">Are you sure you wish to delete this course? Once deleted, it can't be recovered</div>

            <div class="text-right">
                <button class="btn btn-secondary  mb-4 ml-2" data-dismiss="modal" type="submit" id="cancel-delete-course">Cancel</button>
                <button  asp-action="DeleteAsyncForCourseSchedule" class="btn btn-danger  mb-4 ml-2">Confirm </button>
            </div>
        </div>

    </div>
</form>