@model Fdm.Ams.ViewModels.CourseModuleViewModel

<form id="trainer-schedule-form" asp-controller="CourseModule" asp-antiforgery="true" data-ajax="true" data-ajax-update="#trainer-schedule-form" data-ajax-mode="replace">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Edit Course</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body modal-lg">

            <div class="row row--spacing">
                <label asp-for="Name" class="col-5"></label>
                <input type="hidden" id="hdnId" asp-for="Id" />
                <input asp-for="Name" type="text" class="col-6 text--smaller form-control" placeholder="Enter name" />
                <span asp-validation-for="Name" class="text-danger ml-200"></span>
            </div>
            <div class="row row--spacing">
                <label asp-for="Description" class="col-5"></label>
                <input asp-for="Description" type="text" class="col-6 text--smaller form-control" placeholder="Enter Description" />
                <span asp-validation-for="Description" class="text-danger ml-200"></span>
            </div>
            <div class="row row--spacing">
                <label asp-for="PreparationNotes" class="col-5"></label>
                <input asp-for="PreparationNotes" type="text" class="col-6 text--smaller form-control" placeholder="Enter PrepNotes" />
                <span asp-validation-for="PreparationNotes" class="text-danger ml-200"></span>
            </div>
            <div class="row mb-0 mt-4">
                <div class="col-6">
                    <div class="border rounded px-2 py-1">
                        <p class="mb-0">Course</p>
                        <div class="row">
                            <div class="col-6 small">
                                Start: <label>@Model.StartDate.Value.ToShortDateString()</label>
                            </div>
                            <div class="col-6 small">
                                End: <label>@Model.EndDate.Value.ToShortDateString()</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="border rounded px-2 py-1">
                        <p class="mb-0">Pathway</p>
                        <div class="row">
                            <div class="col-6 small">
                                Start:<label>@Model.CourseStartDate.Value.ToShortDateString()</label>
                            </div>
                            <div class="col-6 small">
                                End: <label>@Model.CourseEndDate.Value.ToShortDateString()</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal-footer  show create-button-slider delete-button-slider unassign-button-slider">
                <div class="mr-auto">
                <button type="button" class="btn btn-danger" data-toggle="collapse" data-target=".delete-button-slider" aria-expanded="false" aria-controls="delete-button-slider">Delete</button>
                </div>
                <div class="mr-lg-n-1">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-primary" data-toggle="collapse" data-target=".unassign-button-slider" aria-expanded="false" aria-controls="unassign-button-slider">Unassign</button>
            <button id="modal-save-trainer" type="button" class="btn btn-primary" data-toggle="collapse" data-target=".create-button-slider" aria-expanded="false" aria-controls="edit-button-slider">Save changes</button>

                </div>
            </div>

<div class="create-button-slider collapse p-3" >
            <div class="alert alert-warning text-center">Are you sure you want to save this course module changes?</div>
            <div class="text-right">
                <button class="btn btn-secondary mb-4 ml-2" data-toggle="collapse" data-target=".create-button-slider" aria-expanded="false"
                        aria-controls="create-button-slider" type="button" id="cancel-create-course">
                    Cancel
                </button>
                <button asp-action="Edit" class="btn btn-primary mb-4 ml-2">Confirm Save</button>
            </div>
        </div>


         <div class="unassign-button-slider collapse p-3" >
            <div class="alert alert-warning text-center">Are you sure you want to unassign this course module?</div>
            <div class="text-right">
                <button class="btn btn-secondary mb-4 ml-2" data-toggle="collapse" data-target=".unassign-button-slider" aria-expanded="false"
                        aria-controls="unassign-button-slider" type="button" id="cancel-create-course">
                    Cancel
                </button>
                <button asp-action="EditUnAssign" class="btn btn-primary mb-4 ml-2">Confirm Unassign</button>
            </div>
        </div>


        <div class="delete-button-slider collapse p-3">
            <div class="alert alert-warning text-center">Are you sure you wish to delete this course module? Once deleted, it can't be recovered</div>

            <div class="text-right">
                <button class="btn btn-secondary  mb-4 ml-2" data-toggle="collapse" data-target=".delete-button-slider" aria-expanded="false"
                            aria-controls="delete-button-slider" type="button" id="cancel-delete-course">Cancel</button>
                <button asp-action="Delete" class="btn btn-danger  mb-4 ml-2">Confirm Delete</button>
            </div>
        </div>

    </div>
</form>
