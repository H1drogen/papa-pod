@model Fdm.Ams.ViewModels.CourseTypeViewModel
@{
    ViewBag.Title = "Pathway Types";
}
<body>
    <div class="is-flex">
        <partial name="_AcademyAdminAside" />
        <div id="update-type-modal" class="modal" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-dialog-update" role="document">
            </div>
        </div>


        <section id="main-content" class="container-fluid [ min-height--full ] content__container">
            <div>
                <div class="row">
                    <div class="col">
                        <h2>@ViewBag.Title</h2>
                    </div>
                    <div class="col">
                        <button type="button" data-toggle="modal" data-target="#create-course-type" class="btn btn-primary pull-right"><i class="fa fa-plus  [ icon-space--right ]"></i>Create New</button>
                    </div>
                </div>
            </div>

            @if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success text-center alert-dismissible fade show mt-3" role="alert">
                    @ViewBag.SuccessMessage
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

            }

            <div class="table-responsive mt-3">
                <table id="course-types" class="table"></table>
            </div>
            <partial name="_CreateCourseType" />
        </section>
    </div>
</body>
<script src="~/js/AcademyAdmin/CourseType.js" type="module"></script>

