@model Fdm.Ams.ViewModels.ProgrammeViewModel

@{
    ViewData["Title"] = "Update Programme";
}

<div class="is-flex">
    <partial name="_AcademyAdminAside" />
    <div id="update-type-modal" class="modal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-update" role="document">
        </div>
    </div>


    <section id="main-content" class="container-fluid [ min-height--full ] content__container">
        <div>
            <div class="row">
                <div class="col">
                    <h2>@ViewBag.Title @Model.Name</h2>
                </div>
            </div>
        </div>

        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success text-center alert-dismissible fade show mt-3" role="alert">
                @ViewBag.SuccessMessage
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }
        <br />
        <form method="post" asp-action="Edit"
              id="partial-form" data-ajax="true" data-ajax-update="#partial-form" data-ajax-mode="replace">
            <div class="modal-body">
                <h1 class="h3">Details</h1>
                <div class="row pl-0">
                    <input type="hidden" asp-for="Id" class="form-control" id="update-template-id">

                    <div class="col-sm-6 form-group">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-sm-6 form-group">
                        <label asp-for="Abbreviation" class="form-label"></label>
                        <input asp-for="Abbreviation" class="form-control" onkeyup="this.value=this.value.toUpperCase()">
                        <span asp-validation-for="Abbreviation" class="text-danger"></span>
                    </div>
                    <div class="col-sm-6 form-group">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>

                <div class="modal-footer show update-button-slider delete-button-slider">
                    <div class="mr-auto m-n3">
                        <button type="button" class="btn btn-danger" data-toggle="collapse" data-target=".delete-button-slider" aria-expanded="false"
                                aria-controls="delete-button-slider">
                            Archive
                        </button>
                    </div>
                    <div class="mr-lg-n3">
                        <a type="button" class="btn btn-secondary" asp-controller="Programme" asp-action="Index">Cancel</a>

                        <button type="button" class="btn btn-primary"
                                data-toggle="collapse" data-target=".update-button-slider" aria-expanded="false"
                                aria-controls="update-button-slider">
                            Update
                        </button>
                    </div>
                </div>
                <div class="update-button-slider collapse">
                    <div class="alert alert-warning text-center">Are you sure you want to update this Programme?</div>
                    <div class="text-right">
                        <button class="btn btn-secondary" type="button"
                                data-toggle="collapse" data-target=".update-button-slider" aria-expanded="false"
                                aria-controls="update-button-slider">
                            Cancel
                        </button>
                        <button asp-action="Edit" type="submit"
                                class="btn btn-primary">
                            Confirm
                        </button>
                    </div>
                </div>
                <div class="delete-button-slider collapse">
                    <div class="alert alert-warning text-center">
                        Are you sure you want to archive this Programme?
                    </div>
                    <div class="text-right">
                        <button class="btn btn-secondary" type="button" id="cancel-delete-trainer" data-toggle="collapse" data-target=".delete-button-slider" aria-expanded="false"
                                aria-controls="delete-button-slider">
                            Cancel
                        </button>
                        <button type="submit" asp-action="Delete" class="btn btn-danger">Confirm</button>
                    </div>
                </div>
            </div>
        </form>

    </section>
</div>
