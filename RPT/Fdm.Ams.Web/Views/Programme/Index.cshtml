@model IEnumerable<Fdm.Ams.ViewModels.ProgrammeViewModel>

@{
    ViewData["Title"] = "Programme";
}

<div class="is-flex">
    <partial name="_AcademyAdminAside" />
    <div id="update-type-modal" class="modal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-update" role="document">
        </div>
    </div>


    <section id="main-content" class="container-fluid [ min-height--full ] content__container">
        <div>
            <div class="row">
                <div class="col">
                    <h2>@ViewBag.Title</h2>
                </div>
                <div class="col">
                    <a asp-action="Create" class="btn btn-primary pull-right">
                        <i class="fa fa-plus  [ icon-space--right ]"></i>Create New
                    </a>
                </div>
            </div>
        </div>

        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success text-center alert-dismissible fade show mt-3" role="alert">
                @ViewBag.SuccessMessage
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }
        <br/>
        <table class="table">
            <thead>
                <tr style="text-align: center;">
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Description)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Abbreviation)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr style="text-align: center;">
                        <td>
                            @Html.DisplayFor(modelItem => item.Name)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Description)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Abbreviation)
                        </td>
                        <td>
                            @Html.ActionLink("Manage", "Details", new {  id=item.Id }, new {  @class="btn btn-secondary" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </section>
</div>

