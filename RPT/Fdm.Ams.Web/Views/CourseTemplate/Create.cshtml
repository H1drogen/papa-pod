@using Fdm.Ams.ViewModels
@model CourseTemplateViewModel

@{
    ViewBag.Title = "Pathway Templates";
}

<div class="is-flex">
	<partial name="_AcademyAdminAside" />

	<section id="main-content" class="container-fluid [ min-height--full ] content__container">
		<h1>Create Pathway Template</h1>


		<form method="post" asp-action="Create" id="create-form">

			<h1 class="h3">Details</h1>
			<div class="row">

				<div class="col-6">

					<div class="form-group">
						<label asp-for="Name"></label>
						<input class="form-control" type="text" asp-for="Name" onblur="this.value = this.value.trimEnd()">
						<span class="text-danger" asp-validation-for="Name"></span>
					</div>

					<div class="form-group">
						<label asp-for="PathwayTypeId"></label>
						
							<select class="form-control" asp-for="PathwayTypeId"
								asp-items="@(new SelectList(Model.PathwayTypeDictionaries, "Key", "Value"))">
								<option value="">Please select Pathway Type</option>
							</select>
							<span class="text-danger" asp-validation-for="PathwayTypeId"></span>

					</div>

					<div class="form-group">
						<label asp-for="RegionId"></label>
							<select class="form-control" asp-for="RegionId"
								asp-items="@(new SelectList(Model.RegionDictionaries, "Key", "Value"))">
								<option value="">Please select Region</option>
							</select>
							<span class="text-danger" asp-validation-for="RegionId"></span>
						
					</div>

				</div>

				<div class="col-6">
					<label asp-for="Description"></label>
					<textarea class="form-control h-75 name-space-validation" asp-for="Description"></textarea>
					<span class="text-danger" asp-validation-for="Description"></span>
				</div>

			</div>

			<h1 class="h3">Courses</h1>

			<div class="row--spacing">
                <p class="alert alert-info"> INFO : Please place course templates on the calendar in the order of occurrence.</p>
            </div>

			<div class="my-3" id="course-template-calendar"></div>

			<span class="text--error" id="calendar-error-message" hidden><em>There are no course templates in the Template row!</em></span>
            <span class="text--error" id="calendar-error-message-temp-row" hidden><em>Please remove course template/templates from temp row!</em></span>
			<span class="text--error" id="calendar-event-duration-error-message" hidden><em>Course Template duration cannot exceed 5 days!</em></span>

			<div class="row" id="created-modules">
				<div class="col-md-3 module cursor-pointer d-none">
					<div class="w-100 bg-dark rounded text-white p-2 mt-2">
						Course Template Placeholder
					</div>
				</div>
			</div>
			<input asp-for="CourseTemplates" id="create-course-module-templates" type="hidden"/>

			<div class="mt-3">
				<div class="create-button-slider show text-lg-right">
					<a asp-controller="CourseTemplate" asp-action="Index" type="button" class="btn btn-secondary">Close</a>
					<button type="button" class="btn btn-primary" data-target=".create-button-slider" data-toggle="collapse" aria-expanded="false" aria-controls="create-new-course-template confirm-button-slider">Create</button>
				</div>
				<div id="confirm-button-slider" class="create-button-slider collapse">
					<div class="alert alert-warning text-center">Are you sure you want to create this Pathway Template?</div>
					<div class="text-lg-right">
						<button class="btn btn-secondary" type="button" data-target=".create-button-slider" data-toggle="collapse" aria-expanded="false" aria-controls="create-new-course-template confirm-button-slider">Cancel</button>
						<button type="submit" class="btn btn-primary">Confirm</button>
					</div>
	
				</div>
			</div>
		</form>
	</section>
</div>

<div class="modal fade" id="unassign-module" tabindex="-1" aria-labelledby="unassignModuleLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="unassignModuleLabel">Unassign Course Template?</h5>
				<button type="button" class="close" data-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">&times;</span>
				</button>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
				<button type="button" class="btn btn-warning" id="unassign-module-template">Unassign</button>
			</div>
		</div>
	</div>
</div>

@*<script src="~/js/AcademyAdmin/CreateCourseTemplate.js" type="module"></script>*@