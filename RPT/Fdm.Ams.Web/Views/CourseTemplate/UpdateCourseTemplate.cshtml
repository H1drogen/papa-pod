@using Fdm.Ams.ViewModels
@model CourseTemplateViewModel

@{
    ViewBag.Title = "Pathway Templates";
}

<div class="is-flex">
	<partial name="_AcademyAdminAside" />

	<section id="main-content" class="container-fluid [ min-height--full ] content__container">
		<h1>Update Pathway Template</h1>


        <form method="post" asp-action="Edit" id="update-course-template-form">
            <h1 class="h3">Details</h1>
            <div class="row pl-0">
                <input type="hidden" asp-for="Id" class="form-control" id="update-template-id">
                <div class="col-6">

				    <div class="form-group">

					    <label asp-for="Name"></label>
					    <input class="form-control" type="text" asp-for="Name">
					    <span class="text-danger" asp-validation-for="Name"></span>
					
                    </div>

                    <div class="form-group">

						<label asp-for="PathwayTypeId"></label>
                        <input class="form-control" asp-for="PathwayTypeName" readonly/>

					</div>

					<div class="form-group">

						<label asp-for="RegionId"></label>
						<input class="form-control" asp-for="RegionName" readonly/>

					</div>

			    </div>

                

			    <div class="col-6 pb-md-5">

				    <label asp-for="Description"></label>
				    <textarea class="form-control h-100 name-space-validation" asp-for="Description"></textarea>
				    <span class="text-danger" asp-validation-for="Description"></span>
				
                </div>

            </div>

            <h1 class="h3">Courses</h1>

            <div class="row--spacing">
                <p class="alert alert-info"> INFO : Please place course templates on the calendar in the order of occurrence.</p>
            </div>

		    <div class="my-3" id="updateTemplateCalendar"></div>

		    <span class="text--error" id="calendar-error-message" hidden><em>There are no course templates in the Template row!</em></span>
            <span class="text--error" id="calendar-error-message-temp-row" hidden><em>Please remove course template/templates from temporary row!</em></span>
            <span class="text--error" id="calendar-event-duration-error-message" hidden><em>Course Template duration cannot exceed 5 days!</em></span>

		    <div class="row" id="update-new-modules">
			    <div class="col-md-3 module cursor-pointer d-none">
				    <div class="w-100 bg-dark rounded text-white p-2 mt-2">
					    Course Template Placeholder
				    </div>
			    </div>
		    </div>

            <input asp-for="CourseTemplates" id="update-course-module-templates" type="hidden"/>

            <div class="mt-3">
                <div class="text-right update-button-slider delete-button-slider show">
                    <button type="button" class="float-left btn btn-danger" data-target=".delete-button-slider" data-toggle="collapse">Delete</button>
                    <a type="button" class="btn btn-secondary" asp-controller="CourseTemplate" asp-action="Index">Close</a>
                    <button type="button" class="btn btn-primary" data-target=".update-button-slider" data-toggle="collapse">Update</button>
                </div>
                <div id="delete-button-slider" class="update-button-slider collapse">
                    <div class="alert alert-warning text-center" >Are you sure you want to update this Pathway Template?</div>
                    <div class="text-right">
                        <button class="btn btn-secondary" type="button" data-target=".update-button-slider" data-toggle="collapse">Cancel</button>
                        <button type="submit" class="btn btn-primary">Confirm</button>
                    </div>
                </div>
                <div id="delete-button-slider" class="delete-button-slider collapse">
                    <div class="alert alert-warning text-center" >Are you sure you want to delete this Pathway Template?</div>
                    <div class="text-right">
                        <button class="btn btn-secondary" type="button" data-target=".delete-button-slider" data-toggle="collapse">Cancel</button>
                        <a asp-controller="CourseTemplate" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Confirm</a>
                    </div>
                </div>
            </div>
        </form>
    </section>
</div>


<div class="modal fade" id="update-unassign-modal" tabindex="-1" aria-labelledby="unassignModuleLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="unassignModuleLabel">Unassign Course Template?</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-warning" id="update-unassign-module">Unassign</button>
      </div>
    </div>
  </div>
</div>

<script src="~/js/AcademyAdmin/UpdateCourseTemplate.js" type="module"></script>