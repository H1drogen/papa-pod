@model IEnumerable<Fdm.Ams.ViewModels.CourseTemplateViewModel>

@{
    ViewData["Title"] = "Pathway Templates";
}

<div class="is-flex">
    <partial name="_AcademyAdminAside" />


    <section id="main-content" class="container-fluid [ min-height--full ] content__container">
        <div>
            <div class="row">
                <div class="col">
                    <h2>@ViewBag.Title</h2>
                </div>
                <div class="col">
                    <a asp-action="Create" class="btn btn-primary pull-right"><i class="fa fa-plus  [ icon-space--right ]" 
                    ></i>Create New</a>
                </div>
            </div>
        </div>
        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success text-center alert-dismissible fade show mb-3" role="alert">
                @ViewBag.SuccessMessage
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

        }
        <br />
        <table class="table">
            <thead>
                <tr style="text-align: center;">
                    <th>
                        Name
                    </th>
                    <th>
                        Description
                    </th>
                    <th>
                        Pathway Type
                    </th>
                    <th>
                        Region
                    </th>
                    <th>
                        
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr style="text-align: center;">
                        <td>
                            @Html.DisplayFor(modelItem => item.Name)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Description)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.PathwayTypeName)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.RegionName)
                        </td>
                        <td>
                            @Html.ActionLink("Manage", "Details", new {  id=item.Id }, new {  @class="btn btn-secondary" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</div>