@{
    ViewBag.Title = "Pathway Templates";
}

<div class="is-flex">
    <partial name="_AcademyAdminAside" />

    <section id="main-content" class="container-fluid [ min-height--full ] content__container">
        <div class="my-2">
            <div class="row">
                <div class="col">
                    <h2>Pathway Templates</h2>
                </div>
                <div class="col">
                     
                    <a asp-action="Create" class="btn btn-primary pull-right"><i class="fa fa-plus  [ icon-space--right ]" 
                    ></i>Create New</a>
                </div>
            </div>
        </div>
        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success text-center alert-dismissible fade show mb-3" role="alert">
                @ViewBag.SuccessMessage
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }

        <div class="table-responsive mt-3">
            <table id="course-templates" class="table"></table>
        </div>

    </section>
</div>

<script src="~/js/AcademyAdmin/CourseTemplate.js" type="module"></script>

