@model IEnumerable<Fdm.Ams.Models.Holiday>

@{
    ViewData["Title"] = "Holidays";
}

<div class="is-flex">
    <partial name="_AcademyAdminAside" />


    <section id="main-content" class="container-fluid [ min-height--full ] content__container">
        <div>
            <div class="row">
                <div class="col">
                    <h2>@ViewBag.Title</h2>
                </div>
                <div class="col">
                    <p data-toggle="modal" data-target="#create-holiday-modal" class="btn btn-primary pull-right " asp-action="Create">
                        <i class="fa fa-plus  [ icon-space--right ]"></i>@Html.ActionLink("Create New", "Create", new {  id="" }, new {  @class="butts" })
                    </p>
                   @* <a data-toggle="modal" data-target="#create-holiday-modal" class="btn btn-primary pull-right" asp-action="Create"><i class="fa fa-plus  [ icon-space--right ]"></i>Create New</a>*@
                    @*<button type="button" data-toggle="modal" data-target="#create-holiday-modal" class="btn btn-primary pull-right"><i class="fa fa-plus  [ icon-space--right ]"></i>Create New</button>*@
                </div>
            </div>
        </div>
        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success text-center alert-dismissible fade show mb-3" role="alert">
                @ViewBag.SuccessMessage
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

        }
        @*<div class="table-responsive mt-3">*@
            <table id="create-holiday" class="table"></table><table class="table">
                <thead>
                <tr style="text-align: center;">
                        <th>
                            @Html.DisplayNameFor(model => model.Name)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Description)
                        </th>
                        <th>
                            Country Name
                        </th>
                        <th>
                        Start Date
                        </th>
                        <th>
                        End Date
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                    <tr style="text-align: center;">
                        <td>
                                @Html.DisplayFor(modelItem => item.Name)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Description)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.CountriesName)
                            </td>
                            <td>
                                @Html.Label(@item.StartDate.ToString("dd/MM/yyyy"))
                            </td>
                            <td>
                                @Html.Label(@item.EndDate.ToString("dd/MM/yyyy"))
                            </td>
                            <td>
                        <td class="btn btn-secondary btn-sm px-4 manage">
                                @Html.ActionLink("Manage", "Details", new {  id=item.Id }, new {  @class="butts" })
                        </td>
@*                                @Html.ActionLink("Details", "Details", new { /* id=item.PrimaryKey */ }) |
                                @Html.ActionLink("Delete", "Delete", new { /* id=item.PrimaryKey */ })*@
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @*<partial name="Create" />*@
@*        <div id="update-modal" class="modal fade" tabindex="-1" role="dialog">
            <div class="modal-dialog update-modal modal-xl modal-dialog-scrollable" role="document">
            </div>
        </div>*@
    </section>

</div>