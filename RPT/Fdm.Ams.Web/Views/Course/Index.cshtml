@model IEnumerable<Fdm.Ams.Models.Course>

@{
    ViewData["Title"] = "Pathways";
}

<div class="is-flex">
    <partial name="_AcademyAdminAside" />


    <section id="main-content" class="container-fluid [ min-height--full ] content__container">
        <div>
            <div class="row">
                <div class="col">
                    <h2>@ViewBag.Title</h2>
                </div>
            </div>
        </div>
        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success text-center alert-dismissible fade show mb-3" role="alert">
                @ViewBag.SuccessMessage
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

        }
        <br/>
        <table class="table">
            <thead>
                <tr style="text-align: center;">
                    <th>
                        Pathway Code
                    </th>
                    <th>
                        Start Date
                    </th>
                    <th>
                        End Date
                    </th>
                    <th>
                        Created By
                    </th>
                    <th>
                        Is Pond
                    </th>
                    <th>
                        Cancelled
                    </th>
                    <th>
                        Max Capacity
                    </th>
                    <th>
                        Pathway Type
                    </th>
                    <th>
                        Region
                    </th>
                    <th>
                        Programme
                    </th>
                    <th>
                        Action
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr style="text-align: center;">
                        <td>
                            @Html.DisplayFor(modelItem => item.PathwayCode)
                        </td>
                        <td>
                            @Html.Label(@item.StartDate?.ToString("dd/MM/yyyy"))
                        </td>
                        <td>
                            @Html.Label(@item.EndDate?.ToString("dd/MM/yyyy"))
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.CreatedBy)
                        </td>
                        <td>
                            @if (@item.IsPond)
                            {
                                @Html.Label("Yes")
                                ;
                            }
                            else
                            {
                                @Html.Label("No")
                                ;
                            }
                        </td>
                        <td>
                            @if (@item.Cancelled)
                            {
                                @Html.Label("Yes")
                                ;
                            }
                            else
                            {
                                @Html.Label("No")
                                ;
                            }
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.MaxCapacity)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.PathwayTypeName)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.RegionName)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.ProgrammeName)
                        </td>
                        <td>
                            @Html.ActionLink("View", "Details", new {  id=item.Id }, new {  @class="btn btn-secondary" })   
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</div>
