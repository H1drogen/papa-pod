@model Fdm.Ams.ViewModels.CourseViewModel

@{
    ViewData["Title"] = "Pathways";
}

<div class="is-flex">
    <partial name="_AcademyAdminAside" />


    <section id="main-content" class="container-fluid [ min-height--full ] content__container">

        <section>

            <section class="row">

                <section class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">Pathway @Model.PathwayCode</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>

                    <form method="post" asp-action="Edit"
                          id="partial-form" data-ajax="true" data-ajax-update="#partial-form" data-ajax-mode="replace">
                        <div class="modal-body show success-message-slider">
                            <h1 class="h3">Details</h1>
                            <div class="row pl-0">

                                <div class="col-sm-6 form-group">
                                    <input type="hidden" asp-for="Id" class="form-control">
                                    <label asp-for="PathwayCode" class="form-label"></label>
                                    <input asp-for="PathwayCode" class="form-control" readonly />
                                </div>

                                <div class="col-sm-6 form-group">
                                    <label asp-for="StartDate" class="form-label"></label>
                                    <input asp-for="StartDate" type="date" class="form-control" readonly />
                                </div>

                                <div class="col-sm-6 form-group">
                                    <label asp-for="EndDate" class="form-label"></label>
                                    <input asp-for="EndDate" type="date" class="form-control" readonly />
                                </div>

                                <div class="col-sm-6 form-group">
                                    <input type="hidden" asp-for="Id" class="form-control">
                                    <label asp-for="CreatedBy" class="form-label"></label>
                                    <input asp-for="CreatedBy" class="form-control" readonly />
                                </div>

                                <div class="col-sm-6 form-group">
                                    <label asp-for="IsPond" class="form-label">Is Pond</label>
                                    @{
                                        var isPondDict = new Dictionary<bool, string>()
                                    {
                                    {true, "Yes" },
                                    {false, "No" }
                                    };

                                        var isPondOptions = isPondDict.Where(x => x.Key != Model.IsPond);

                                    }
                                    <select class="form-control" asp-for="IsPond" asp-items="@(new SelectList(isPondOptions, "Key", "Value"))" disabled>
                                        <option value="">Please select</option>
                                        <option value="@Model.IsPond" selected>@isPondDict[Model.IsPond]</option>
                                    </select>
                                </div>

                                <div class="col-sm-6 form-group">
                                    <label asp-for="Cancelled" class="form-label">Cancelled</label>
                                    @{
                                        var cancelledDict = new Dictionary<bool, string>()
                                        {
                                            {true, "Yes" },
                                            {false, "No" }
                                        };

                                        var cancelledOptions = cancelledDict.Where(x => x.Key != Model.Cancelled);

                                    }
                                    <select class="form-control" asp-for="Cancelled" asp-items="@(new SelectList(cancelledOptions, "Key", "Value"))" disabled>
                                        <option value="">Please select</option>
                                        <option value="@Model.Cancelled" selected>@cancelledDict[Model.Cancelled]</option>
                                    </select>
                                </div>


                                <div class="col-sm-6 form-group">
                                    <input type="hidden" asp-for="Id" class="form-control">
                                    <label asp-for="MaxCapacity" class="form-label"></label>
                                    <input asp-for="MaxCapacity" class="form-control" />
                                </div>

                                <div class="col-sm-6 form-group">
                                    <label asp-for="PathwayTypeName" class="form-label">Pathway Type</label>
                                    @{
                                        var pathwayTypes = Model.PathwayTypesDictionary.Where(x => x.Key != Model.PathwayTypeId);
                                    }
                                    <select class="form-control" asp-for="PathwayTypeName" asp-items="@(new SelectList(pathwayTypes, "Key", "Value"))" disabled>
                                        <option value="">Please select Pathway Type</option>
                                        <option value="@Model.PathwayTypesDictionary[Model.PathwayTypeId]" selected>@Model.PathwayTypeName</option>
                                    </select>
                                </div>

                                <div class="col-sm-6 form-group">
                                    <label asp-for="RegionName" class="form-label">Region</label>
                                    @{
                                        var regions = Model.RegionsDictionary.Where(x => x.Key != Model.RegionId);
                                    }
                                    <select class="form-control" asp-for="RegionName" asp-items="@(new SelectList(regions, "Key", "Value"))" disabled>
                                        <option value="">Please select Region</option>
                                        <option value="@Model.RegionsDictionary[Model.RegionId]" selected>@Model.RegionName</option>
                                    </select>
                                </div>

                                <div class="col-sm-6 form-group">
                                    <label asp-for="ProgrammeName" class="form-label">Programme</label>
                                    @{
                                        var programmes = Model.ProgrammesDictionary.Where(x => x.Key != Model.ProgrammeId);
                                    }
                                    <select class="form-control" asp-for="ProgrammeName" asp-items="@(new SelectList(programmes, "Key", "Value"))" disabled>
                                        <option value="">Please select Programme</option>
                                        <option value="@Model.ProgrammesDictionary[Model.ProgrammeId]" selected>@Model.ProgrammeName</option>
                                    </select>
                                </div>

                                <div class="modal-body show success-message-slider">
                                    <h1 class="h3">Courses</h1>
                                    <div class="mr-lg-n3 p-2 mt-2">
                                        @foreach (var course in Model.CoursesDictionary)
                                        {
                                            <button type="button" class="btn bg-dark rounded text-white">@course.Value</button>
                                        }

                                    </div>
                                </div>

                            </div>

                            <div class="text-right">
                                <a type="button" class="btn btn-secondary" data-dismiss="modal" asp-action="Index">Close</a>
                            </div>
                          
                        </div>

                    </form>

                </section>

            </section>

        </section>

    </section>

</div>
