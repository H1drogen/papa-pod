@using Fdm.Ams.ViewModels
@model CourseViewModel


<div id="create-course-module" class="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create Pathway</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form method="post" autocomplete="off">

                <div class="modal-body modal-lg">
                    <fieldset>

                        @*Not sure if description & prep notes should be included. Currently the data
                            from the CourseModuleTemplate selected is used as default*@
                    <div class="row row--spacing mr-0">
                           <p class="alert alert-info ml-3 mr-sm-4"> INFO : Please select Pathway Template, Region and Start date to create a Pathway Code.</p>
                    </div>
                        
                    <div class="row row--spacing">
                        <span class="col-5 text-left">Pathway Code: </span>
                        <label  id="pathway-code" class="font-weight-bold"></label>
                      
                    </div>
                        <input type="hidden" id="hidden-pathway-code" asp-for="PathwayCode" />

                    <div class="row row--spacing">
                    <span class="col-5">Pathway Template: </span>
                    <select id="templates" class="col-6 form-control course-code-dependancy" asp-for="PathwayTemplateId"  asp-items="@(new SelectList(Model.CourseTemplatesDictionary, "Key", "Value"))">  
                            <option value="">--Select--</option>  
                    </select>  
                     <span  asp-validation-for="PathwayTemplateId" class="text-danger ml-200"></span>
                    </div>

                    <div class="row row--spacing">
                    <span class="col-5">Office: </span>
                    <select id="office" class="col-6 form-control course-code-dependancy" asp-for="OfficeId" asp-items="@(new SelectList(Model.OfficesDictionary, "Key", "Value"))">  
                           <option value="">--Select--</option>     
                    </select>   
                       <span  asp-validation-for="OfficeId" class="text-danger ml-200"></span>
                    </div>
                        <div class="row row--spacing">
                            <span class="col-5">Programme: </span>
                            <select id="programme" class="col-6 form-control course-code-dependancy" asp-for="ProgrammeId" asp-items="@(new SelectList(Model.ProgrammesDictionary, "Key", "Value"))">
                                <option value="">--Select--</option>
                            </select>
                            <span asp-validation-for="ProgrammeId" class="text-danger ml-200"></span>
                        </div>
                        <hr>
                        <div class="row row--spacing">
                             <span class="col-5">Start Date:</span>
                            <input type="datetime-local" id="start-date" asp-for="StartDate" class="col-6 date-field form-control course-code-dependancy" />
                             <span asp-validation-for="StartDate" class="text-danger ml-200"></span>
                        </div>
                        <div class="row row--spacing">
                            <span class="col-5">Timezone:</span>
                         <input type="hidden" id="hidden-timezone" asp-for="SelectedTimeZone" >
                         <select id="timezone" class="col-6 form-control" asp-for="Timezones"  asp-items="@(new SelectList(Model.Timezones.TimeZoneDictionary, "Key", "Value"))">  
                             <option value="">--Select--</option>  
                          </select> 
                         <span  asp-validation-for="Timezones" class="text-danger ml-200"></span>
                        </div>
                          <div class="row row--spacing">
                            <span class="col-5 text-left">Max Capacity: </span>
                            <input type="number" id="max-capacity" asp-for="MaxCapacity"  class="col-6 text--smaller form-control" />
                            <span  asp-validation-for="MaxCapacity" class="text-danger ml-200"></span>
                             
                        </div>
                    </fieldset>
                </div>
                 <div class="modal-footer row show mr-3  create-button-slider">
                    <button id="create-new-course" type="button" class="btn btn-primary" data-toggle="collapse" data-target=".create-button-slider" aria-expanded="false">Submit</button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                </div>
                 <div id="create-button-slider" class="create-button-slider collapse" >
                    <div class="alert alert-warning text-center m-4 ml-xl-3 mr-md-4">Are you sure you want to add this Pathway?</div>
                        <div class="text-right">
                               <button class="btn btn-secondary mb-4 ml-2" data-dismiss="modal" type="submit" id="cancel-delete-course">Cancel</button>
                            <button id="confirm-saave-course" asp-action="Post"  class="btn btn-primary mb-4 ml-2 mr-2 mr-4">Confirm</button>
                        </div>
                 </div>
            </form>
        </div>
    </div>
</div>