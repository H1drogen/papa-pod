@using Fdm.Ams.ViewModels
@model CourseModuleTemplateViewModel

<div id="create-modal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create Course Template</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <form method="post" asp-action="Post">
                <div class="modal-body show success-message-slider">
                    <h1 class="h3">Details</h1>
                    <div class="row pl-0">
                        <div class="col-sm-6 form-group">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" onblur="this.value = this.value.trimEnd()" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="col-sm-6 form-group">
                            <label asp-for="Duration" class="form-label"></label>
                            <input asp-for="Duration" class="form-control">
                            <span asp-validation-for="Duration" class="text-danger"></span>
                        </div>
                        <div class="col-sm-6 form-group">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                        <div class="col-sm-6 form-group">
                            <label asp-for="PreparationNotes" class="form-label"></label>
                            <textarea asp-for="PreparationNotes" class="form-control"></textarea>
                            <span asp-validation-for="PreparationNotes" class="text-danger"></span>
                        </div>
                        <div class="col-sm-6 form-group">
                            <label asp-for="IsExtra" class="form-label"></label>
                            <select asp-for="IsExtra" class="form-control">
                                <option value="false">Course</option>
                                <option value="true">Activity</option>
                            </select>
                        </div>
                    </div>

                    <div class="modal-footer show create-button-slider">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>

                        <button type="button" class="btn btn-primary"
                                data-toggle="collapse" data-target=".create-button-slider" aria-expanded="false"
                                aria-controls="create-button-slider">
                            Create
                        </button>
                    </div>

                    <div class="create-button-slider collapse">
                        <div class="alert alert-warning text-center">Are you sure you want to add this Course Template?</div>
                        <div class="text-right">
                            <button class="btn btn-secondary" type="button"
                                    data-toggle="collapse" data-target=".create-button-slider" aria-expanded="false"
                                    aria-controls="create-button-slider">
                                Cancel
                            </button>
                            <button id="confirm-create-new-course-module-template" type="submit"
                                    class="btn btn-primary">
                                Confirm
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
