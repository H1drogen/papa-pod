@using Fdm.Ams.ViewModels
@model CourseModuleTemplateViewModel

<div class="modal-content">
    <div class="modal-header">
        <h5 class="modal-title">Update Course Template</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="false">&times;</span>
        </button>
    </div>
    <form method="post" asp-action="Edit" 
          id="partial-form" data-ajax="true" data-ajax-update="#partial-form" data-ajax-mode="replace">
        <div class="modal-body">
            <h1 class="h3">Details</h1>
            <div class="row pl-0">
                <input type="hidden" asp-for="Id" class="form-control" id="update-template-id">  
                <div class="col-sm-6 form-group">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-sm-6 form-group">
                    <label asp-for="Duration" class="form-label"></label>
                    <input asp-for="Duration" class="form-control">
                    <span asp-validation-for="Duration" class="text-danger"></span>
                </div>
                <div class="col-sm-6 form-group">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="col-sm-6 form-group">
                    <label asp-for="PreparationNotes" class="form-label"></label>
                    <textarea asp-for="PreparationNotes" class="form-control"></textarea>
                    <span asp-validation-for="PreparationNotes" class="text-danger"></span>
                </div>
                <div class="col-sm-6 form-group">
                    <label asp-for="IsExtra" class="form-label"></label>
                    <select asp-for="IsExtra" class="form-control">
                        <option value="false">Course</option>
                        <option value="true">Activity</option>
                    </select>
                </div>
            </div>

            <div class="modal-footer show update-button-slider">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>

                <button type="button" class="btn btn-primary"
                        data-toggle="collapse" data-target=".update-button-slider" aria-expanded="false"
                        aria-controls="update-button-slider">
                    Update
                </button>
            </div>

            <div class="update-button-slider collapse">
                <div class="alert alert-warning text-center">Are you sure you want to update this Course Template?</div>
                <div class="text-right">
                    <button class="btn btn-secondary" type="button"
                            data-toggle="collapse" data-target=".update-button-slider" aria-expanded="false"
                            aria-controls="update-button-slider">
                        Cancel
                    </button>
                    <button id="confirm-update-new-course-module-template" type="submit"
                            class="btn btn-primary">
                        Confirm
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

