@model Fdm.Ams.ViewModels.CountryViewModel

@{
    ViewBag.Title = "Countries";
}

<div class="is-flex">
    <partial name="_AcademyAdminAside" />

    <section id="main-content" class="container-fluid [ min-height--full ] content__container">
        <div class="row">
            <div class="modal-content">
                <div class="col-md-4">
                    <form method="post" asp-action="Post">
                        <div class="modal-body show success-message-slider">
                            <h1 class="h3">Create</h1>
                            <div class="row pl-0">
                                <div class="col-sm-6 form-group">
                                    <label asp-for="Name" class="form-label"></label>
                                    <input asp-for="Name" class="form-control" />
                                    <span asp-validation-for="Name" class="text-danger" onblur="this.value = this.value.trimEnd()"></span>
                                </div>
                                <div class="col-sm-6 form-group">
                                    <label asp-for="RegionId" class="form-label"></label>
                                    <select class="form-control" asp-for="RegionId"
                                            asp-items="@(new SelectList(Model.RegionDictionaries, "Key", "Value"))">
                                        <option value="">Please select Region</option>
                                    </select>
                                    <span asp-validation-for="RegionId" class="text-danger"></span>
                                </div>
                                <div class="col-sm-6 form-group form-check">
                                    <label class="form-check-label">
                                        <input class="form-check-input" asp-for="IsActive" /> @Html.DisplayNameFor(model => model.IsActive)
                                    </label>
                                </div>

                            </div>

                            <div class="modal-footer show create-button-slider">
                                <div class="mr-lg-n3">
                                    <a asp-action="Index" class="btn btn-secondary" data-dismiss="modal">Cancel</a>

                                    <button type="button" class="btn btn-primary"
                                            data-toggle="collapse" data-target=".create-button-slider" aria-expanded="false"
                                            aria-controls="create-button-slider">
                                        Create
                                    </button>
                                </div>
                            </div>

                            <div class="create-button-slider collapse">
                                <div class="alert alert-warning text-center">Are you sure you want to add this Holiday?</div>
                                <div class="text-right">
                                    <button class="btn btn-secondary" type="button"
                                            data-toggle="collapse" data-target=".create-button-slider" aria-expanded="false"
                                            aria-controls="create-button-slider">
                                        Cancel
                                    </button>
                                    <button id="confirm-create-new-country" type="submit"
                                            class="btn btn-primary">
                                        Confirm
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
</div>

