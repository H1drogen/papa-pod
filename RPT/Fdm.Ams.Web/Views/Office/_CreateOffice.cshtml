@model Fdm.Ams.ViewModels.OfficeViewModel


<div class="modal-content">
    <div class="modal-header">
        <h5 class="modal-title">Create Office</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>

    <form method="post" asp-action="Post"
          id="partial-form" data-ajax="true" data-ajax-update="#partial-form" data-ajax-mode="replace">
        <div class="modal-body show success-message-slider">
            <h1 class="h3">Details</h1>
            <div class="row pl-0">
                <div class="col-sm-6 form-group">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" onblur="this.value = this.value.trimEnd()" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="col-sm-6 form-group">
                    <label asp-for="Abbreviation" class="form-label"></label>
                    <input asp-for="Abbreviation" class="form-control" onkeyup="this.value=this.value.toUpperCase()" />
                    <span asp-validation-for="Abbreviation" class="text-danger"></span>
                </div>

                <div class="col-sm-6 form-group">
                    <label asp-for="CountryId" class="form-label"></label>
                    <select class="form-control" asp-for="CountryId"
                            asp-items="@(new SelectList(Model.CountriesDictionary, "Key", "Value"))">
                        <option value="">Please select Country</option>
                    </select>
                    <span asp-validation-for="CountryId" class="text-danger"></span>
                </div>

                <div class="col-sm-6 form-group">
                    <label asp-for="IsActive" class="form-label"></label>
                    <select asp-for="IsActive" class="form-control">
                        <option value="false">Inactive</option>
                        <option value="true" selected="selected">Active</option>
                    </select>
                </div>

                <div class="col-sm-6 form-group">
                    <label asp-for="IsPopUp" class="form-label"></label>
                    <select asp-for="IsPopUp" class="form-control">
                        <option value="false">No</option>
                        <option value="true" selected="selected">Yes</option>
                    </select>
                </div>

            </div>

            <div class="modal-footer show create-button-slider">
                <div class="mr-lg-n3">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>

                    <button type="button" class="btn btn-primary"
                            data-toggle="collapse" data-target=".create-button-slider" aria-expanded="false"
                            aria-controls="create-button-slider">
                        Create
                    </button>
                </div>
            </div>

            <div class="create-button-slider collapse">
                <div class="alert alert-warning text-center">Are you sure you want to add this office?</div>
                <div class="text-right">
                    <button class="btn btn-secondary" type="button"
                            data-toggle="collapse" data-target=".create-button-slider" aria-expanded="false"
                            aria-controls="create-button-slider">
                        Cancel
                    </button>
                    <button id="confirm-create-new-office" type="submit"
                            class="btn btn-primary">
                        Confirm
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>
